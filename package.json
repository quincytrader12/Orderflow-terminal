{
  "name": "orderflow-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based crypto orderflow terminal: footprint, heatmap, DOM, tape, TPO, liquidations, options flow and more over direct exchange WebSockets.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs && node e2e/venues.mjs",
    "history-server": "node server/history-server.mjs",
    "e2e:smoke": "node e2e/smoke.mjs",
    "e2e:venues": "node e2e/venues.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "flexlayout-react": "^0.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
